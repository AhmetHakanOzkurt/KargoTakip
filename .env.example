# Database
DB_PASSWORD=YourSecureStrongPasswordHere123!

# JWT
# En az 32 karakter. Uretmek icin: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=KargoTakip
JWT_AUDIENCE=KargoTakipUsers
JWT_EXPIRY_HOURS=8

# Email
EMAIL_FROM_EMAIL=your-email@example.com
EMAIL_FROM_NAME=KargoTakip
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_PASSWORD=your-app-password-here

# Consolidation
CONSOLIDATION_OCCUPANCY_THRESHOLD=70
CONSOLIDATION_MAX_WAIT_HOURS=48
CONSOLIDATION_CHECK_INTERVAL_MINUTES=60

# Cloudflare
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token

# Sadece quick-tunnel profili kullanilirsa gereklidir
VPS_API_URL=
UPDATER_SECRET=

# Mail sablonlarindaki takip linkinin adresi
APP_PUBLIC_URL=http://localhost:3000

# Sadece quick-tunnel profili icin: host docker grubunun GID degeri
# (stat -c %g /var/run/docker.sock)
DOCKER_GID=999
